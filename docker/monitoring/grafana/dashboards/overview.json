{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "title": "PopCut Overview",
    "uid": "popcut-overview",
    "version": 1,
    "schemaVersion": 39,
    "timezone": "browser",
    "editable": true,
    "tags": ["popcut", "production"],
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up, instance)",
          "refresh": 1,
          "includeAll": true,
          "allValue": ".*",
          "datasource": { "uid": "prometheus" }
        }
      ]
    },
    "panels": [
      {
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{instance=~\"$instance\"}[5m])) by (instance, status)",
            "legendFormat": "{{ instance }} - {{ status }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        },
        "description": "API request rate in requests per second, broken down by service instance and HTTP status"
      },
      {
        "title": "API Latency (p99)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, instance))",
            "legendFormat": "{{ instance }} p99"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, instance))",
            "legendFormat": "{{ instance }} p95"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, instance))",
            "legendFormat": "{{ instance }} p50"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        },
        "description": "API request latency percentiles (p99, p95, p50) in seconds"
      },
      {
        "title": "API Error Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{status=~\"5..\",instance=~\"$instance\"}[5m])) / sum(rate(http_requests_total{instance=~\"$instance\"}[5m])) * 100)",
            "legendFormat": "Error Rate %"
          },
          {
            "expr": "(sum(rate(http_requests_total{status=~\"4..\",instance=~\"$instance\"}[5m])) / sum(rate(http_requests_total{instance=~\"$instance\"}[5m])) * 100)",
            "legendFormat": "4xx Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 3 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "description": "API error rate as percentage of total requests. Thresholds: yellow > 3%, red > 5%"
      },
      {
        "title": "Database Connections",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "legendFormat": "Active connections"
          },
          {
            "expr": "pg_stat_activity_max_connections",
            "legendFormat": "Max connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 100 }
              ]
            }
          }
        },
        "description": "PostgreSQL active connections vs max connections. Warning at 80, critical at 100"
      },
      {
        "title": "Database Query Performance",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit[5m])",
            "legendFormat": "Transactions committed/s"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback[5m])",
            "legendFormat": "Transactions rolled back/s"
          },
          {
            "expr": "rate(pg_stat_database_tup_fetched[5m])",
            "legendFormat": "Rows fetched/s"
          },
          {
            "expr": "rate(pg_stat_database_tup_inserted[5m]) + rate(pg_stat_database_tup_updated[5m]) + rate(pg_stat_database_tup_deleted[5m])",
            "legendFormat": "Rows modified/s"
          }
        ],
        "description": "Database transaction and row operation rates"
      },
      {
        "title": "Redis Cache Hit Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
            "legendFormat": "Hit Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        },
        "description": "Redis cache hit rate as percentage. Lower bound target: > 80%"
      },
      {
        "title": "Redis Memory Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "Used"
          },
          {
            "expr": "redis_memory_max_bytes",
            "legendFormat": "Max"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 0 },
                { "color": "red", "value": 0 }
              ]
            }
          }
        },
        "description": "Redis memory usage in bytes vs max configured"
      },
      {
        "title": "Storage Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",instance=~\"$instance\"} / node_filesystem_size_bytes{mountpoint=\"/\",instance=~\"$instance\"}) * 100)",
            "legendFormat": "Disk used %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        },
        "description": "Filesystem usage percentage. Warning at 80%, critical at 90%"
      },
      {
        "title": "AI Service Inference Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(ai_inference_requests_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Inference requests/s"
          },
          {
            "expr": "rate(ai_inference_errors_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Inference errors/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        },
        "description": "AI service inference request and error rates"
      },
      {
        "title": "AI Model Latency",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(ai_inference_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, model))",
            "legendFormat": "p99 {{ model }}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(ai_inference_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, model))",
            "legendFormat": "p95 {{ model }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        },
        "description": "AI model inference latency percentiles by model type"
      },
      {
        "title": "Export Jobs",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(export_jobs_started_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Jobs started/s"
          },
          {
            "expr": "rate(export_jobs_completed_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Jobs completed/s"
          },
          {
            "expr": "rate(export_jobs_failed_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Jobs failed/s"
          }
        ],
        "description": "Export job throughput: started, completed, and failed per second"
      },
      {
        "title": "Export Queue Depth",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "export_queue_depth{instance=~\"$instance\"}",
            "legendFormat": "Queue depth"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        },
        "description": "Number of pending export jobs in the queue"
      },
      {
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)",
            "legendFormat": "CPU {{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        },
        "description": "System CPU usage percentage across all cores"
      },
      {
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "100 - ((node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}) * 100)",
            "legendFormat": "Memory {{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 80 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        },
        "description": "System memory usage percentage"
      },
      {
        "title": "Network I/O",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*\"}[5m])",
            "legendFormat": "RX {{ device }}"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*\"}[5m])",
            "legendFormat": "TX {{ device }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        },
        "description": "Network receive and transmit bytes per second (excluding loopback and virtual interfaces)"
      },
      {
        "title": "Container CPU (cAdvisor)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{name!~\"\"}[5m])) by (name)",
            "legendFormat": "{{ name }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0
          }
        },
        "description": "Per-container CPU usage from cAdvisor"
      },
      {
        "title": "Container Memory (cAdvisor)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{name!~\"\"}) by (name)",
            "legendFormat": "{{ name }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        },
        "description": "Per-container working set memory from cAdvisor"
      },
      {
        "title": "Service Uptime",
        "type": "stat",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "up",
            "legendFormat": "{{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            }
          }
        },
        "description": "Service up/down status. 1 = up, 0 = down"
      },
      {
        "title": "Service Restarts",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "changes(up{instance=~\"$instance\"}[30m])",
            "legendFormat": "{{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        },
        "description": "Number of service restarts in the last 30 minutes"
      },
      {
        "title": "Disk I/O",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "rate(node_disk_read_bytes_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Read {{ device }}"
          },
          {
            "expr": "rate(node_disk_written_bytes_total{instance=~\"$instance\"}[5m])",
            "legendFormat": "Write {{ device }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "Bps"
          }
        },
        "description": "Disk read/write throughput in bytes per second"
      },
      {
        "title": "Redis Connected Clients",
        "type": "graph",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
        "datasource": { "uid": "prometheus" },
        "targets": [
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Connected clients"
          },
          {
            "expr": "redis_connected_slaves",
            "legendFormat": "Connected slaves"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0
          }
        },
        "description": "Redis connected clients and slave count"
      }
    ]
  }
}
