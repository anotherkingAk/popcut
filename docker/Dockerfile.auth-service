FROM node:26-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY services/auth-service/package.json ./services/auth-service/
COPY packages/ ./packages/
RUN pnpm install --frozen-lockfile --filter @popcut/auth-service

COPY services/auth-service/ ./services/auth-service/
COPY tsconfig.base.json ./
RUN pnpm --filter @popcut/auth-service exec prisma generate
RUN pnpm --filter @popcut/auth-service build

FROM node:26-alpine
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY --from=builder /app/services/auth-service/dist ./dist
COPY --from=builder /app/services/auth-service/prisma ./prisma
COPY --from=builder /app/services/auth-service/package.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 4001
CMD ["node", "dist/main"]
