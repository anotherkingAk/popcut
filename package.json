{
  "name": "popcut",
  "version": "1.0.0",
  "private": true,
  "description": "PopCut - AI-powered professional video editing platform",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @popcut/web dev\" \"pnpm --filter @popcut/admin dev\" \"pnpm --filter @popcut/auth-service dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "services:dev": "docker compose -f docker/docker-compose.yml up -d",
    "services:stop": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
