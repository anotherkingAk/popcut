{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@capcard/ui": ["./packages/ui/src"],
      "@capcard/editor-engine": ["./packages/editor-engine/src"],
      "@capcard/api-sdk": ["./packages/api-sdk/src"],
      "@capcard/animations": ["./packages/animations/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
